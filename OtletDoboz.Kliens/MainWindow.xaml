<Window x:Class="OtletDoboz.Kliens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OtletDoboz.Kliens"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Make left column take most space and right column a fixed portion so the form (including radio buttons) is visible -->
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Stretch">
            <TextBox x:Name="tb_Title" Height="36" FontSize="24" VerticalAlignment="Top">Cím</TextBox>
            <TextBox x:Name="tb_Content" Height="250" Margin="0,31,0,31" VerticalAlignment="Stretch" FontSize="24">Leírás</TextBox>
            <ComboBox x:Name="cb_Kategoriak"> </ComboBox>
            <Label>Privát?</Label>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rb_Igaz" GroupName="isPrivate" VerticalContentAlignment="Center">Igen</RadioButton>
                <RadioButton x:Name="rb_Hamis" GroupName="isPrivate" VerticalContentAlignment="Center">Nem</RadioButton>
            </StackPanel>
            <Button x:Name="btn_Bekuld" Height="36" VerticalAlignment="Bottom" Click="btn_Bekuld_Click">Beküldés</Button>
        </StackPanel>
        
        <DockPanel Grid.Column="0" LastChildFill="True">
        <ComboBox x:Name="cb_Kategoriak_Filter" DockPanel.Dock="Top" SelectionChanged="cb_Kategoriak_Filter_SelectionChanged"></ComboBox>
            <ListBox x:Name="lb_Ideas">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,3,0,5" Foreground="#333" />
                            <TextBlock Foreground="Gray" FontSize="11">
                            <Run Text="Szavazatok:" />   
                            <Run Text="{Binding Votes}" FontWeight="Bold" Foreground="DarkGreen" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
